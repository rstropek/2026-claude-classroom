{
  "name": "ai-tutor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:llm": "E2E_LLM=1 playwright test tests/e2e/todos.llm.spec.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:generate": "npx --yes auth@latest generate --config lib/auth-cli.ts --adapter drizzle --dialect sqlite --output lib/auth-schema.ts -y"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.59",
    "@ag-ui/core": "^0.0.59",
    "@ag-ui/mastra": "^1.1.2",
    "@better-auth/drizzle-adapter": "^1.7.3",
    "@copilotkit/react-core": "^1.70.1",
    "@copilotkit/runtime": "^1.70.1",
    "@libsql/client": "^0.18.0",
    "@mastra/core": "^1.64.0",
    "@mastra/libsql": "^1.22.3",
    "@mastra/memory": "^1.28.2",
    "better-auth": "^1.7.3",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "better-auth": {
      "vitest": "$vitest"
    }
  }
}
