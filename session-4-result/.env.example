# SQLite database file (Drizzle, Better Auth, and Mastra memory all use it)
DATABASE_URL=file:./data/app.db
# OpenRouter: the LLM behind the Mastra agent
OPENROUTER_API_KEY=sk-or-v1-...
# Better Auth (secret: openssl rand -base64 32)
BETTER_AUTH_SECRET=...
BETTER_AUTH_URL=http://localhost:3000
# Optional: send OpenRouter traffic through a local reverse proxy to watch it,
# e.g. mitmproxy with --mode reverse:https://openrouter.ai on port 8090.
# Must include /api/v1. Leave unset to talk to OpenRouter directly.
# OPENROUTER_BASE_URL=http://localhost:8090/api/v1
