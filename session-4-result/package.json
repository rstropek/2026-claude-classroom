{
  "name": "ai-tutor",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/api-contract",
    "cli"
  ],
  "scripts": {
    "predev": "npm run build:views",
    "dev": "next dev",
    "prebuild": "npm run build:views",
    "build": "next build",
    "start": "next start",
    "build:views": "node scripts/build-views.mjs",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:llm": "E2E_LLM=1 playwright test tests/e2e/todos.llm.spec.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "auth:generate": "npx --yes auth@latest generate --config lib/auth-cli.ts --adapter drizzle --dialect sqlite --output lib/auth-schema.ts -y"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.59",
    "@ag-ui/core": "^0.0.59",
    "@ag-ui/mastra": "^1.1.4",
    "@better-auth/cimd": "^1.7.5",
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@better-auth/mcp": "^1.7.5",
    "@better-auth/oauth-provider": "^1.7.5",
    "@copilotkit/react-core": "^1.73.0",
    "@copilotkit/runtime": "^1.73.0",
    "@libsql/client": "^0.18.0",
    "@mastra/core": "^1.67.0",
    "@mastra/libsql": "^1.23.0",
    "@mastra/memory": "^1.30.0",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "ai-tutor-api-contract": "*",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@modelcontextprotocol/client": "^2.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.1"
  }
}
